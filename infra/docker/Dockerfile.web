FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @hub/web build

FROM node:22-alpine AS runner
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
RUN addgroup -S hub && adduser -S hub -G hub
COPY --from=builder --chown=hub:hub /app/apps/web/.next/standalone ./
COPY --from=builder --chown=hub:hub /app/apps/web/.next/static ./apps/web/.next/static
USER hub
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
