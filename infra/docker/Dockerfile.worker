FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @hub/worker build

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S hub && adduser -S hub -G hub
COPY --from=builder --chown=hub:hub /app/node_modules ./node_modules
COPY --from=builder --chown=hub:hub /app/apps/worker/dist ./apps/worker/dist
USER hub
CMD ["node", "apps/worker/dist/apps/worker/src/main.js"]
