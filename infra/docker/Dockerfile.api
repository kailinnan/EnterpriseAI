FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @hub/api build

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable && addgroup -S hub && adduser -S hub -G hub
COPY --from=builder --chown=hub:hub /app/node_modules ./node_modules
COPY --from=builder --chown=hub:hub /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=builder --chown=hub:hub /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=hub:hub /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=hub:hub /app/packages ./packages
USER hub
EXPOSE 3001
CMD ["node", "apps/api/dist/apps/api/src/main.js"]
