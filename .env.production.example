NODE_ENV=production
SITE_ADDRESS=ai.example.com
IMAGE_TAG=latest
WEB_URL=https://ai.example.com
API_URL=https://ai.example.com
NEXT_PUBLIC_API_URL=/api/v1
POSTGRES_USER=hub
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hub
DATABASE_URL=postgresql://hub:replace-with-a-long-random-password@postgres:5432/hub
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=enterprise-ai-hub
S3_ACCESS_KEY=replace-minio-access-key
S3_SECRET_KEY=replace-minio-secret-key
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
MODEL_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=20971520
HTTP_TOOL_ALLOWED_DOMAINS=api.example.com
AGENT_MAX_STEPS=8
AGENT_MAX_RUNTIME_MS=60000
AGENT_MAX_TOKENS=12000
CHAT_HISTORY_TOKENS=4000
