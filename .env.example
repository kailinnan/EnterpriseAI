NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=enterprise-ai-hub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
MODEL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=20971520
HTTP_TOOL_ALLOWED_DOMAINS=api.example.com
AGENT_MAX_STEPS=8
AGENT_MAX_RUNTIME_MS=60000
AGENT_MAX_TOKENS=12000
